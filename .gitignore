# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups - real business data, never committed
/backups

# uploaded product photos - real business data, never committed; the directory
# itself (and .gitkeep) stays tracked so it exists on a fresh clone
/public/uploads/products/*
!/public/uploads/products/.gitkeep
.env.local
